# Copie para .env.dev / .env.qa / .env.staging / .env.prod conforme o ambiente.
# Esses arquivos NAO devem ser commitados (ja estao no .gitignore).

BASE_URL=https://example.com
API_URL=https://api.example.com

# Pool de contas de teste: um par de variaveis por conta, numerado a partir de 1.
# Cada worker paralelo recebe uma conta exclusiva, o que evita que dois testes
# alterem o estado do mesmo usuario ao mesmo tempo.
#
# O numero de contas define o paralelismo da suite (ver playwright.config.ts):
# 1 conta = execucao serial. Para rodar mais rapido, cadastre mais contas.
TEST_USER_1_EMAIL=qa1@example.com
TEST_USER_1_PASSWORD=changeme1
TEST_USER_2_EMAIL=qa2@example.com
TEST_USER_2_PASSWORD=changeme2

# Formato legado, ainda aceito quando nenhuma conta numerada existe.
# Nao use se alguma senha contiver virgula ou espaco nas pontas.
# TEST_USER_EMAIL=qa1@example.com,qa2@example.com
# TEST_USER_PASSWORD=changeme1,changeme2

# Usada apenas pelo script scripts/generate-tests.ts (geracao offline, nao entra no runtime dos testes)
ANTHROPIC_API_KEY=
